# Ollama Configuration for Smart Room AI

# Ollama server base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name - recommended for 6GB+ RAM systems:
# - llama3.2:3b (2.0 GB) - good balance of capability and memory usage
# - llama3.2:1b (1.3 GB) - smaller but less capable
# - mistral (not available yet)
OLLAMA_MODEL=llama3.2:3b

# Temperature for randomness (lower = more deterministic)
# 0.1-0.2 is good for structured parsing
OLLAMA_TEMPERATURE=0.2

# Maximum tokens per response (default: 512)
OLLAMA_NUM_PREDICT=512

# Timeout in seconds (default: 60)
OLLAMA_TIMEOUT=60

# Optional: Set to true to enable debug logging
# DEBUG=true