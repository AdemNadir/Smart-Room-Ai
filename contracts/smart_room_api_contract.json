{
  "openapi": "3.1.0",
  "info": {
    "title": "SMART ROOM AI API Contract",
    "version": "1.0.0",
    "description": "Shared interface contract. Frontend and AI can start with mocks while backend implements these endpoints."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "offline": true
                }
              }
            }
          }
        }
      }
    },
    "/ai/parse-request": {
      "post": {
        "summary": "Parse natural-language request into structured criteria",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parsed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rooms": {
      "get": {
        "summary": "List rooms",
        "responses": {
          "200": {
            "description": "Rooms",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rooms": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Room"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/search/rooms": {
      "post": {
        "summary": "Return rooms verified available by backend, ranked by suitability",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchCriteria"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Available rooms",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/bookings": {
      "post": {
        "summary": "Create booking; backend must re-check availability transactionally",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "409": {
            "description": "Room conflict"
          }
        }
      }
    },
    "/admin/overview": {
      "get": {
        "summary": "Verified dashboard metrics",
        "responses": {
          "200": {
            "description": "Metrics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminMetrics"
                }
              }
            }
          }
        }
      }
    },
    "/admin/ai-insights": {
      "post": {
        "summary": "Generate text insights only from supplied verified metrics",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminMetrics"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Insights",
            "content": {
              "application/json": {
                "example": {
                  "insights": [
                    "17 of 28 active rooms are currently available."
                  ],
                  "source_note": "Based only on supplied database metrics."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchCriteria": {
        "type": "object",
        "required": [
          "date",
          "start_time",
          "end_time",
          "capacity",
          "equipment"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "start_time": {
            "type": "string",
            "example": "10:00"
          },
          "end_time": {
            "type": "string",
            "example": "12:00"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "equipment": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "building": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ParseRequest": {
        "type": "object",
        "required": [
          "text",
          "language",
          "reference_date"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "fr",
              "ar",
              "unknown"
            ]
          },
          "reference_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "ParseResponse": {
        "type": "object",
        "required": [
          "criteria",
          "missing_fields",
          "confidence",
          "needs_confirmation"
        ],
        "properties": {
          "criteria": {
            "$ref": "#/components/schemas/SearchCriteria"
          },
          "missing_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "needs_confirmation": {
            "type": "boolean"
          },
          "interpretation": {
            "type": "string"
          }
        }
      },
      "Room": {
        "type": "object",
        "required": [
          "id",
          "name",
          "building",
          "capacity",
          "equipment",
          "room_type",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "building": {
            "type": "string"
          },
          "floor": {
            "type": [
              "integer",
              "null"
            ]
          },
          "capacity": {
            "type": "integer"
          },
          "equipment": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "room_type": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "RecommendedRoom": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Room"
          },
          {
            "type": "object",
            "required": [
              "recommendation_score",
              "reason"
            ],
            "properties": {
              "recommendation_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "reason": {
                "type": "string"
              }
            }
          }
        ]
      },
      "SearchResponse": {
        "type": "object",
        "required": [
          "criteria",
          "rooms",
          "count"
        ],
        "properties": {
          "criteria": {
            "$ref": "#/components/schemas/SearchCriteria"
          },
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecommendedRoom"
            }
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "BookingRequest": {
        "type": "object",
        "required": [
          "room_id",
          "date",
          "start_time",
          "end_time",
          "purpose",
          "expected_attendees"
        ],
        "properties": {
          "room_id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "start_time": {
            "type": "string"
          },
          "end_time": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "expected_attendees": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Booking": {
        "type": "object",
        "required": [
          "id",
          "room_id",
          "date",
          "start_time",
          "end_time",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "room_id": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "start_time": {
            "type": "string"
          },
          "end_time": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "pending_approval",
              "rejected",
              "cancelled"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AdminMetrics": {
        "type": "object",
        "required": [
          "total_rooms",
          "active_rooms",
          "available_now",
          "occupied_now",
          "pending_bookings",
          "utilization_percent",
          "period"
        ],
        "properties": {
          "total_rooms": {
            "type": "integer"
          },
          "active_rooms": {
            "type": "integer"
          },
          "available_now": {
            "type": "integer"
          },
          "occupied_now": {
            "type": "integer"
          },
          "pending_bookings": {
            "type": "integer"
          },
          "utilization_percent": {
            "type": "number"
          },
          "period": {
            "type": "string"
          }
        }
      }
    }
  },
  "x-team-ownership": {
    "member_1_ai": [
      "POST /ai/parse-request",
      "AI ranking function used after backend availability filtering",
      "POST /admin/ai-insights"
    ],
    "member_2_backend": [
      "Database and data models",
      "GET /health",
      "GET /rooms",
      "POST /search/rooms",
      "POST /bookings",
      "GET /admin/overview",
      "LAN/offline setup"
    ],
    "member_3_frontend": [
      "React UI",
      "Professor search and booking screens",
      "Admin dashboard",
      "Use mock-data.json immediately; later swap to API calls"
    ]
  },
  "x-integration-rules": [
    "All paths are prefixed /api/v1.",
    "Dates use YYYY-MM-DD; times use 24-hour HH:MM campus local time.",
    "Equipment identifiers are lowercase, e.g. projector, whiteboard, computers.",
    "AI parsing extracts criteria; professor can review/edit before search.",
    "Backend alone decides room availability and confirms bookings.",
    "Backend must re-check availability inside a database transaction when booking; return HTTP 409 on conflict.",
    "AI ranking only receives rooms already verified available by backend.",
    "Insights must be grounded in database metrics, never invented.",
    "Use synthetic demo data and label it as demo data.",
    "If an endpoint is unfinished, use the matching mock response and keep working."
  ]
}